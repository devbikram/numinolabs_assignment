# Environment
ENVIRONMENT=development
APP_VERSION=0.1.0
APP_TITLE=Library Management Service

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/numinolabs_assignment

# Auth (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Token revocation store (Redis).
# Strongly recommended in production (multiple workers / replicas).
# Leave unset to use the single-process in-memory fallback (dev only).
# REDIS_URL=redis://localhost:6379/0

# CORS
# Production defaults below allow only the headers and methods the frontend needs.
# To use permissive wildcard values during local development, uncomment and edit:
# CORS_HEADERS=["*"]
# CORS_METHODS=["*"]
CORS_ORIGINS=["http://localhost:3000"]
CORS_HEADERS=["Authorization", "Content-Type"]
CORS_METHODS=["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
